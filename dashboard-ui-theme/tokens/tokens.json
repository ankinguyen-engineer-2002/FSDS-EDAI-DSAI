{
  "name": "forecast-dashboard-theme",
  "source": "Prototype-AI-Dashboard/forecast-dashboard/web",
  "fonts": {
    "sans": "Anthropic Sans",
    "display": "Anthropic Sans",
    "mono": "Anthropic Sans",
    "files": {
      "romans": "fonts/AnthropicSans-Romans.woff2",
      "italics": "fonts/AnthropicSans-Italics.woff2"
    }
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px"
  },
  "motion": {
    "fast": "140ms",
    "base": "220ms",
    "slow": "360ms",
    "easeOut": "cubic-bezier(0.22, 1, 0.36, 1)",
    "easeInOut": "cubic-bezier(0.65, 0, 0.35, 1)"
  },
  "modes": {
    "light": {
      "paper": "#f5f4ef",
      "surface": "#fffefa",
      "ink": "#2c2b28",
      "inkMuted": "#706d65",
      "line": "#e1ded5",
      "lineStrong": "#c9c5b9",
      "grid": "#eae7df",
      "axis": "#928d81",
      "surfaceRaised": "#faf9f5",
      "hover": "#eeece4",
      "focus": "#b65d40",
      "canvas": "#f5f4ef",
      "brand": "#ad5438",
      "brandSoft": "#f3e7df",
      "good": "#3f7d5c",
      "goodSoft": "#e2ede5",
      "warn": "#c07f1f",
      "warnSoft": "#f5ead2",
      "bad": "#ad3b2c",
      "badSoft": "#f5dfd9",
      "lag4": "#674b40",
      "lag3": "#ad5438",
      "lag2": "#c68a68",
      "lag1": "#8d887b",
      "lag0": "#b5ac95",
      "naive": "#2c2b28",
      "chartAccuracy": "#ad5438",
      "chartBias": "#847248",
      "chartLifecycle": "#a78470",
      "chartSo": "#a08049"
    },
    "dark": {
      "paper": "#242422",
      "surface": "#2c2c29",
      "ink": "#eceae2",
      "inkMuted": "#b2aea3",
      "line": "#41413b",
      "lineStrong": "#5d5b52",
      "grid": "#383833",
      "axis": "#999487",
      "surfaceRaised": "#32322e",
      "hover": "#3b3a34",
      "focus": "#e19a7c",
      "canvas": "#242422",
      "brand": "#e19a7c",
      "brandSoft": "#44332b",
      "good": "#79bd91",
      "goodSoft": "#1f382a",
      "warn": "#d5a25b",
      "warnSoft": "#3d321f",
      "bad": "#de8178",
      "badSoft": "#422522",
      "lag4": "#e9c7b1",
      "lag3": "#e19a7c",
      "lag2": "#bd7e61",
      "lag1": "#a6a18f",
      "lag0": "#777466",
      "naive": "#eceae2",
      "chartAccuracy": "#e19a7c",
      "chartBias": "#c9b480",
      "chartLifecycle": "#c5a28d",
      "chartSo": "#ceb078"
    }
  },
  "tone": {
    "good": { "text": "good", "background": "goodSoft" },
    "warn": { "text": "warn", "background": "warnSoft" },
    "bad": { "text": "bad", "background": "badSoft" },
    "neutral": { "text": "inkMuted", "background": "line" }
  },
  "layout": {
    "shellMaxWidth": "72rem",
    "chatDockWidth": "392px",
    "chatOpenContentOffset": "416px",
    "headerHeight": "76px",
    "brandLogo": { "width": "92px", "height": "32px" }
  },
  "runtime": {
    "storageKey": "forecast-theme",
    "default": "os-preference",
    "modes": ["light", "dark"]
  }
}
